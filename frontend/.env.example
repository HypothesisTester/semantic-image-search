# Copy to .env.local and adjust. All are optional; these are the defaults.

# Backend services (docker compose up)
VITE_INDEX_URL=http://localhost:8001
VITE_SEARCH_URL=http://localhost:8002

# Public demo build: no sign-in, searches the COCO images.
# Locally the demo service runs on http://localhost:8003
# (docker compose --profile demo up), which is the default search URL
# when this is true.
VITE_DEMO_MODE=false
